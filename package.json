{
  "name": "card-game-maker",
  "private": true,
  "version": "1.0.2",
  "description": "类三国杀卡牌游戏框架 - 可自定义武将和技能，AI辅助生成代码",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/launch.mjs",
    "relay": "node server/relay.mjs",
    "build": "node scripts/subset-font.mjs && vite build",
    "fonts:subset": "node scripts/subset-font.mjs",
    "preview": "vite preview",
    "test": "node scripts/run-smoke.mjs",
    "test:engine": "node scripts/run-smoke.mjs",
    "test:ui": "node scripts/run-ui-smoke.mjs",
    "test:net": "node scripts/net-smoke.mjs",
    "test:online": "node scripts/run-online-host-smoke.mjs",
    "test:mobile": "node scripts/headless-mobile-check.mjs",
    "test:audio": "node scripts/audio-check.mjs",
    "build:apk": "node server/build-apk.mjs",
    "android:sync": "node node_modules/@capacitor/cli/bin/capacitor sync android",
    "apk:legacy": "node scripts/build-apk.mjs",
    "apk:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-android.ps1",
    "test:all": "node scripts/run-smoke.mjs && node scripts/run-ui-smoke.mjs && node scripts/net-smoke.mjs && node scripts/run-online-host-smoke.mjs",
    "shots": "node scripts/screenshots.mjs",
    "desktop": "npm run build && node desktop/build-portable.mjs",
    "release:build": "npm run build && node scripts/package-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@vitejs/plugin-react": "^4.2.0",
    "subset-font": "^2.9.0",
    "vite": "^5.1.0"
  }
}
